# ============================================
# NODE.JS NOTES API - Environment Variables
# ============================================
#
# Скопируйте этот файл в .env и заполните реальными значениями
# cp .env.example .env

# ============================================
# SERVER
# ============================================
# Порт, на котором запустится сервер
PORT=3000

# Окружение: development, production, test
NODE_ENV=development

# ============================================
# LOGGING
# ============================================
# Уровень логирования: trace, debug, info, warn, error, fatal
LOG_LEVEL=debug

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Вариант 1: Отдельные параметры (рекомендуется для development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=notes_db

# Вариант 2: Connection string (рекомендуется для production)
# Если указан DATABASE_URL, он имеет приоритет над отдельными параметрами
# DATABASE_URL=postgresql://user:password@localhost:5432/notes_db

# ============================================
# CORS
# ============================================
# Список разрешённых origins через запятую
# ОБЯЗАТЕЛЬНО для production! В development используются дефолтные значения.
# 
# Development (можно не указывать, будет использовано дефолтное):
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# Production (укажите реальные домены):
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# ============================================
# RATE LIMITING
# ============================================
# Максимум запросов за окно времени
# RATE_LIMIT_MAX=100
# Окно времени в миллисекундах (15 минут = 900000)
# RATE_LIMIT_WINDOW_MS=900000
